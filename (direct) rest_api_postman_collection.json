{
  "info": {
    "_postman_id": "b2c3d4e5-6f7a-4b8c-9d0e-1f2a3b4c5d6e",
    "name": "Grand Alaric PHM REST API (direct)",
    "description": "Hits the company PHM backend DIRECTLY, bypassing the local MCP server (server.py).\nThis is plain REST, not MCP — no /mcp, no initialize, no SSE, no session.\n\nBase URL: {{baseUrl}}  (https://api6.alarichotels.com/webapi/chatgpt)\nAuth: every request sends the header  phm-chat-api-key: {{apiKey}}\n\nSET {{apiKey}} in the collection variables (Postman) before running — it is the value\nof GRAND_ALARIC_API_KEY from .env. Do NOT commit the key into this file.\n\nDates use YYYY-MM-DD. Guests are split into adult/child. These bodies match exactly\nwhat server.py sends upstream, so behaviour should be identical to the MCP path.\nThe GNW package needs a 3-night minimum stay (room-packages example uses 3 nights).\n\nWARNING: 'create order' places a REAL booking. Run intentionally only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://api6.alarichotels.com/webapi/chatgpt", "type": "string" },
    { "key": "apiKey", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. GET /hotels  (search_hotels)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "phm-chat-api-key", "value": "{{apiKey}}" }
        ],
        "url": { "raw": "{{baseUrl}}/hotels", "host": ["{{baseUrl}}"], "path": ["hotels"] },
        "description": "Lists all Grand Alaric properties. No body."
      }
    },
    {
      "name": "2. POST /rooms  (check_availability)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "phm-chat-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotel_id\": \"GSV\",\n  \"checkin\": \"2026-07-01\",\n  \"checkout\": \"2026-07-03\",\n  \"adult\": 2,\n  \"child\": 0,\n  \"promocode\": \"\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/rooms", "host": ["{{baseUrl}}"], "path": ["rooms"] },
        "description": "Available room types and rates for a hotel and date range."
      }
    },
    {
      "name": "3. POST /package  (check_packages)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "phm-chat-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotel_id\": \"GSV\",\n  \"checkin\": \"2026-07-01\",\n  \"checkout\": \"2026-07-03\",\n  \"adult\": 2,\n  \"child\": 0,\n  \"promocode\": \"\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/package", "host": ["{{baseUrl}}"], "path": ["package"] },
        "description": "Bookable packages (promo bundles). Note the package_code in the response for /room-packages."
      }
    },
    {
      "name": "4. POST /room-packages  (check_room_packages)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "phm-chat-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotel_id\": \"GSV\",\n  \"checkin\": \"2026-07-01\",\n  \"checkout\": \"2026-07-04\",\n  \"adult\": 2,\n  \"child\": 0,\n  \"promocode\": \"\",\n  \"package_code\": \"GNW\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/room-packages", "host": ["{{baseUrl}}"], "path": ["room-packages"] },
        "description": "Rooms and prices within a package. GNW requires a 3-night minimum (this example is 3 nights). Replace package_code with one from /package."
      }
    },
    {
      "name": "5. GET /nationality  (list_nationalities)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "phm-chat-api-key", "value": "{{apiKey}}" }
        ],
        "url": { "raw": "{{baseUrl}}/nationality", "host": ["{{baseUrl}}"], "path": ["nationality"] },
        "description": "Valid nation_code / phone-code values for the order guest object. No body."
      }
    },
    {
      "name": "6. POST /orders  (create_order)  [LIVE BOOKING]",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "phm-chat-api-key", "value": "{{apiKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"hotel_id\": \"GSV\",\n  \"checkin\": \"2026-07-01\",\n  \"checkout\": \"2026-07-03\",\n  \"adult\": 2,\n  \"child\": 0,\n  \"promocode\": \"\",\n  \"room_id\": \"SUPK-IWS312ROO\",\n  \"guest\": {\n    \"salutation\": 3,\n    \"nation_code\": \"id\",\n    \"name\": \"Test Guest\",\n    \"phone\": \"+6282214171060\",\n    \"email\": \"test@example.com\"\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/orders", "host": ["{{baseUrl}}"], "path": ["orders"] },
        "description": "WARNING: places a REAL booking. Send EITHER room_id (plain room) OR package_code + package_id (package) — not both. The room_id here is a placeholder; replace with a real one from /rooms. Returns the order result incl. a payment link."
      }
    }
  ]
}
