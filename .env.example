# Copy to .env and fill in. All values are read from the environment — nothing is
# hardcoded, so rotating a key is just editing this and restarting the server.

# --- Backend auth (REQUIRED) ---------------------------------------------------
# Sent to the PHM backend as the phm-chat-api-key header. Set as a platform SECRET
# in production, not committed. Rotate by changing this value and restarting.
API_KEY=
# API_KEY_HEADER=phm-chat-api-key      # override only if the backend renames the header
# API_BASE_URL=https://api6.alarichotels.com/webapi/chatgpt   # override to point elsewhere

# --- Hosting (REQUIRED when deployed behind a domain) --------------------------
# Without these the server starts in stdio mode / loopback / rejects the public Host
# header — i.e. "deployed but doesn't work". _check_config() logs an error for each.
MCP_TRANSPORT=streamable-http          # default "stdio" = no HTTP server at all
HOST=0.0.0.0                           # default 127.0.0.1 = unreachable behind a proxy
PORT=8000                              # match the platform's port (often injected as $PORT)
MCP_ALLOWED_HOSTS=mcp.grandalaric.com  # your public host(s), space/comma separated; "*" disables the check

# --- White-label / features (optional) -----------------------------------------
# HOTEL_NAME=Grand Alaric Hotel Assistant
# HOTEL_LOCATION=Bandung, Indonesia
# HOTEL_DOMAIN=grandalaric.com         # drives widget CSP resource_domains + widgetDomain
# RESOURCE_DOMAINS=                    # comma-separated CSP hosts; overrides HOTEL_DOMAIN default
# PAYMENT_DOMAIN=https://m.grandalaric.com
# GOOGLE_MAPS_API_KEY=                 # hotel-details map thumbnail; restrict by referrer + Maps Static API
# EXTRAS_ENABLED=true                  # set false to hide add-ons if the backend regresses
# CURRENCY=IDR                         # widget money formatting (ISO code); LOCALE below
# LOCALE=id-ID                         # BCP-47 locale for number/currency formatting

# --- Multi-tenant merge (optional) ---------------------------------------------
# ONE MCP URL that shows hotels from several backends merged. search fans out to all;
# each hotel routes back to its own backend for details/booking. Empty = single tenant.
# TENANTS=vie=https://api6.alarichotels.com/chatgpt/vie,ga=https://api6.alarichotels.com/webapi/chatgpt
#   → one connector at https://<host>/mcp shows both. (All tenants must share CURRENCY.)
